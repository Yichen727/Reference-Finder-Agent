# Copy to .env. Only the backend reads the OpenAI key.
APP_MODE=mock
BACKEND_URL=http://127.0.0.1:8000
DATA_DIR=data
OPENAI_API_KEY=
# Planning and structured curation use a fast model; discovery uses Web Search.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_SEARCH_MODEL=gpt-5.4-mini
SEARCH_PROVIDER=openai
REQUEST_TIMEOUT_SECONDS=45
# May be lowered, never raised above 15.
MAX_REFERENCES=15
# Per-run discovery limits, including bounded retries and curation requests.
SEARCH_QUERY_LIMIT=4
SEARCH_MAX_REQUESTS=6
SEARCH_CANDIDATE_LIMIT=30
SEARCH_TIMEOUT_SECONDS=75
SEARCH_RUN_TIMEOUT_SECONDS=240
SEARCH_RETRY_COUNT=1
