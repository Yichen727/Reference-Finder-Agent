# Copy to .env. Only the backend reads the OpenAI key.
APP_MODE=live
BACKEND_URL=http://127.0.0.1:8000
DATA_DIR=data
OPENAI_API_KEY=
# Planning and structured curation use a fast model; discovery uses Web Search.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_SEARCH_MODEL=gpt-5.4-mini
SEARCH_PROVIDER=openai
REQUEST_TIMEOUT_SECONDS=45
# May be lowered, never raised above 20.
MAX_REFERENCES=20
# Optional: only list source domains whose preview use has been explicitly approved.
PREVIEW_APPROVED_DOMAINS=[]
# Per-run discovery limits, including bounded retries and curation requests.
SEARCH_QUERY_LIMIT=4
SEARCH_MAX_REQUESTS=6
SEARCH_CANDIDATE_LIMIT=30
SEARCH_TIMEOUT_SECONDS=75
SEARCH_RUN_TIMEOUT_SECONDS=240
SEARCH_RETRY_COUNT=1
# Public source-page checks: separate HTTP limits, with robots and DNS/IP validation.
VERIFICATION_MAX_PAGES=18
VERIFICATION_MAX_REQUESTS=60
VERIFICATION_WORKERS=4
VERIFICATION_TIMEOUT_SECONDS=8
VERIFICATION_TOTAL_SECONDS=45
VERIFICATION_MAX_BYTES=1000000
VERIFICATION_MAX_REDIRECTS=3
